# Copy to .env and fill in. Never commit .env.
PORT=3000

# Required for /api/admin/*. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Where the SQLite file lives
DATABASE_PATH=data/studio.db

# Email (optional). Without SMTP_HOST, enquiries are still saved and emails are skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zaira Christa <hello@zairachrista.studio>"
NOTIFY_TO=hello@zairachrista.studio

# Comma-separated origins allowed to call the API from another site (leave empty if same origin)
CORS_ORIGINS=
